# LINE Login Channel (LIFF, OAuth, ID Token Verification)
LINE_LOGIN_CHANNEL_ID="your_line_login_channel_id"
LINE_LOGIN_CHANNEL_SECRET="your_line_login_channel_secret"
LIFF_ID="your_liff_id"

# LINE Messaging API Channel (Bot, Webhooks, Push Messages, Rich Menu)
LINE_MESSAGING_CHANNEL_ID="your_line_messaging_channel_id"
LINE_MESSAGING_CHANNEL_SECRET="your_line_messaging_channel_secret"
LINE_CHANNEL_ACCESS_TOKEN="your_channel_access_token"

# LINE User Target
LINE_USER_ID="your_line_user_id"

# Cloudflare Configuration
CLOUDFLARE_API_TOKEN="your_cloudflare_api_token"
CLOUDFLARE_ACCOUNT_ID="your_cloudflare_account_id"

# General Application Secret Key
SECRET_KEY="your_secret_key"
